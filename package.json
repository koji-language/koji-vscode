{
    "name": "koji",
    "displayName": "Koji",
    "description": "Koji for VS Code: syntax highlighting, and the errors, types and declarations of the Koji language server",
    "version": "0.1.0",
    "publisher": "koji-language",
    "preview": true,
    "license": "MIT",
    "icon": "images/icon.png",
    "galleryBanner": {
        "color": "#c2410c",
        "theme": "dark"
    },
    "homepage": "https://koji-language.github.io/koji-website/",
    "repository": {
        "type": "git",
        "url": "https://github.com/koji-language/koji-vscode"
    },
    "bugs": {
        "url": "https://github.com/koji-language/koji-vscode/issues"
    },
    "keywords": [
        "koji",
        "kj",
        "language server",
        "lsp",
        "syntax"
    ],
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "koji",
                "aliases": [
                    "Koji",
                    "koji"
                ],
                "extensions": [
                    ".kj"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "koji",
                "scopeName": "source.koji",
                "path": "./syntaxes/koji.tmLanguage.json"
            }
        ],
        "configuration": {
            "title": "Koji",
            "properties": {
                "koji.kojicPath": {
                    "type": "string",
                    "default": "kojic",
                    "description": "The kojic command (its path when it is not on the PATH): the extension runs `kojic lsp`."
                }
            }
        }
    },
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:koji"
    ],
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@vscode/vsce": "^4.1.1",
        "ovsx": "^1.4.0"
    },
    "scripts": {
        "update-grammar": "sh scripts/update-grammar.sh",
        "package": "vsce package"
    }
}
